# Désactive le listing de répertoire (ex: /data/ affichait la liste des fichiers)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirection des anciennes URLs indexées par Google avec le mauvais paramètre
    # (project.html?id=...) vers le paramètre réellement utilisé par le site (?project=...)
    RewriteCond %{QUERY_STRING} ^id=(.+)$
    RewriteRule ^project\.html$ /project.html?project=%1 [R=301,L]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force www (hôte canonique déclaré dans les balises canonical / robots.txt / sitemap)
    RewriteCond %{HTTP_HOST} ^cea-ingenierie\.fr$ [NC]
    RewriteRule ^ https://www.cea-ingenierie.fr%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # Charset
    AddDefaultCharset UTF-8

    # Force HTTPS — max-age 1 jour pour commencer (augmenter après validation)
    Header always set Strict-Transport-Security "max-age=86400"

    # Anti-clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Anti-MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions navigateur
    Header always set Permissions-Policy "camera=(), microphone=(), payment=()"

    # XSS protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Content Security Policy
    # unsafe-inline requis : scripts inline (AOS.init, canonical URL dynamique)
    # Sources externes inventoriées : googleapis, gstatic, cdnjs, jsdelivr, unpkg
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
